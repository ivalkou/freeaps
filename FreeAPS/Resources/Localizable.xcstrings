          "stringUnit": {
            "state": "translated",
            "value": "After you create glucose records in the Health app, please open FreeAPS X to help us guaranteed transfer changed data"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois que vous avez créé des enregistrements de glucose dans l'application Santé, veuillez ouvrir FreeAPS X pour nous aider à garantir le transfert des données"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "After you create glucose records in the Health app, please open FreeAPS X to help us guaranteed transfer changed data"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver creato record glicemici nell'app Salute, apri FreeAPS X per aiutarci a trasferire i dati modificati"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter at du har lagt til blodsukker i Helse-appen, vennligst åpne FreeAPS X for å sikre overføring av endrede data"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na het maken van glucoserecords in de Gezondheid-app, opent u FreeAPS X om ervoor te zorgen dat de gewijzigde gegevens veilig worden overgedragen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "After you create glucose records in the Health app, please open FreeAPS X to help us guaranteed transfer changed data"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
