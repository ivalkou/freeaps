    "Default is false. Any existing temp basals during times the pump was suspended will be deleted and 0 temp basals to negate the profile basal rates during times pump is suspended will be added.": {
      "comment": "Suspend Zeros IOB",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Default is false. Any existing temp basals during times the pump was suspended will be deleted and 0 temp basals to negate the profile basal rates during times pump is suspended will be added."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Default is false. Any existing temp basals during times the pump was suspended will be deleted and 0 temp basals to negate the profile basal rates during times pump is suspended will be added."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Default is false. Any existing temp basals during times the pump was suspended will be deleted and 0 temp basals to negate the profile basal rates during times pump is suspended will be added."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardwert ist aus. Alle vorhandenen Temp-Basalraten werden gelöscht und auf 0 gesetzt, während die Pumpe aussetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default is false. Any existing temp basals during times the pump was suspended will be deleted and 0 temp basals to negate the profile basal rates during times pump is suspended will be added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
