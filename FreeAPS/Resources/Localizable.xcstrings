    "After you create glucose records in the Health app, please open FreeAPS X to help us guaranteed transfer changed data": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "After you create glucose records in the Health app, please open FreeAPS X to help us guaranteed transfer changed data"
