    "When true, raises BG target when autosens detects sensitivity": {
      "comment": "Sensitivity Raises Target",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "When true, raises BG target when autosens detects sensitivity"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "When true, raises BG target when autosens detects sensitivity"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "When true, raises BG target when autosens detects sensitivity"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird das BG-Ziel erhöht, sobald Autosens erhöhte Empfindlichkeit erkennt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "When true, raises BG target when autosens detects sensitivity"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the system detects you're more sensitive to insulin than usual, it raises your target to prevent lows. Useful safety feature if your sensitivity varies day to day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando es verdadero, aumenta el objetivo BG cuando los autosens detectan sensibilidad"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "When true, raises BG target when autosens detects sensitivity"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vrai, augmente la cible Glycémie lorsque l'autosens détecte une plus grande sensibilité"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "When true, raises BG target when autosens detects sensitivity"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando VERO, aumenta il target glicemia quando l'autosens rileva la maggiore sensibilità insulinica"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "When true, raises BG target when autosens detects sensitivity"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer waar, verhoogt het BG streefdoel als autosens gevoeligheid detecteert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "When true, raises BG target when autosens detects sensitivity"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "When true, raises BG target when autosens detects sensitivity"
          }
        },
        "pt-BR": {
          "stringUnit": {
