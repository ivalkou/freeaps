          "stringUnit": {
            "state": "translated",
            "value": "After you create glucose records in the Health app, please open FreeAPS X to help us guaranteed transfer changed data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После создания записей глюкозы в приложении Здоровье, пожалуйста, откройте FreeAPS X для гарантированной синхронизации данных"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "After you create glucose records in the Health app, please open FreeAPS X to help us guaranteed transfer changed data"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter att du lagt till glukos i appen 'Hälsa', öppna FreeAPS X för att bekräfta att överföring skett på rätt sätt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık uygulamasında glikoz kayıtları oluşturduktan sonra, değiştirilen verileri aktarmayı garanti etmemize yardımcı olmak için lütfen FreeAPS X'i açın"
          }
        },
        "uk": {
          "stringUnit": {
