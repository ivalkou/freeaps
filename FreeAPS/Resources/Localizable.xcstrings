            "state": "translated",
            "value": "默认为禁用。当启用时，允许SMB(如果其他情况下启用)，即使是比较高的临时目标。"
          }
        }
      }
    },
    "Defaults to false. When true, always enable supermicrobolus (unless disabled by high temptarget).": {
      "comment": "Enable SMB Always",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, always enable supermicrobolus (unless disabled by high temptarget)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, always enable supermicrobolus (unless disabled by high temptarget)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, always enable supermicrobolus (unless disabled by high temptarget)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard Wert ist \"Aus\". Wenn aktiviert werden immer SMB verwandt (es sei denn, es wird ein höheres temporäres Ziel eingestellt)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, always enable supermicrobolus (unless disabled by high temptarget)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMB will deliver small insulin boluses continuously to keep glucose in range. Use this for aggressive glucose control when you're confident in your settings. Note: High temp targets still disable SMB for safety."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
