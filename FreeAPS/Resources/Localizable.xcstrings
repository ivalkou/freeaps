            "value": "After you create glucose records in the Health app, please open FreeAPS X to help us guaranteed transfer changed data"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem Sie Glukosedatensätze in der Health App erstellt oder gelöscht haben, öffnen Sie bitte FreeAPS X, um die Übertragung der geänderten Daten sicher zu gewährleisten"
          }
        },
        "es": {
