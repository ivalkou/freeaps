          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, always enable supermicrobolus (unless disabled by high temptarget)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, always enable supermicrobolus (unless disabled by high temptarget)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SMB будет регулярно вводить небольшие болюсы для поддержания глюкозы в норме. Используйте, когда уверены в своих настройках. Высокие временные цели по-прежнему отключают SMB для безопасности."
          }
        },
        "sk": {
