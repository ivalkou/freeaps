    "Defaults to false. When true, will lower BG target when autosens detects resistance": {
      "comment": "Resistance Lowers Target",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard Einstellung ist \"Aus\". Wenn aktiviert, wird das BG-Ziel herabgesetzt, sobald Autosens eine niedrige Empfindlichkeit erkennt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the system detects insulin resistance, it lowers your target to be more aggressive. Helps maintain control during sick days or hormonal changes when you need more insulin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto es falso. Cuando es verdadero, reducirá el objetivo BG cuando detecte resistencia"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faux par défaut. Quand vrai, réduira la cible de glycémie lorsque l'autosens détecte une résistance à l'insuline"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori predefiniti sono falsi. Quando VERO, abbasserà il target glicemia quando autosens rilevano resistenza insulinica incrementata"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard op onwaar. Wanneer waar, zal het BG doel verlagen als autosens minder gevoeligheid detecteert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда система обнаруживает инсулинорезистентность, она снижает цель для более агрессивного контроля. Помогает поддерживать контроль во время болезни или гормональных изменений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av som standard. Sänker målvärde för blodsocker när 'Autosens' upptäcker minskad insulinkänslighet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak geçersizdir. Geçerli yapıldığında, otoduyarlılık direnci tespit ettiğinde KŞ hedefini düşürür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to false. When true, will lower BG target when autosens detects resistance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
